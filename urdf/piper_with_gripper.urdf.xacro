<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_with_gripper">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="connected_to" default="world"/>
  <xacro:arg name="xyz" default="0 0 0"/>
  <xacro:arg name="rpy" default="0 0 0"/>
  <xacro:arg name="can_interface" default="can0"/>
  <xacro:arg name="init_can" default="false"/>
  <xacro:arg name="load_gripper" default="true"/>
  <xacro:arg name="ros2_control" default="true"/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="enable_gripper_control" default="false"/>
  <xacro:arg name="xyz_ee" default="0 0 0"/>
  <xacro:arg name="rpy_ee" default="0 0 0"/>
  <xacro:arg
    name="tcp_xyz"
    default="${xacro.load_yaml('$(find piper_description)/config/gripper_tcp.yaml')['origin']['xyz']}"/>
  <xacro:arg
    name="tcp_rpy"
    default="${xacro.load_yaml('$(find piper_description)/config/gripper_tcp.yaml')['origin']['rpy']}"/>

  <xacro:include filename="$(find piper_description)/urdf/parts/piper_arm.xacro"/>
  <xacro:include filename="$(find piper_description)/urdf/parts/piper_gripper.xacro"/>
  <xacro:include filename="$(find piper_description)/urdf/parts/piper_arm.ros2_control.xacro"/>

  <xacro:piper_arm
    prefix="$(arg prefix)"
    connected_to="$(arg connected_to)"
    xyz="$(arg xyz)"
    rpy="$(arg rpy)"
    description_pkg="piper_description"/>

  <xacro:if value="$(arg load_gripper)">
    <xacro:piper_gripper
      prefix="$(arg prefix)"
      parent_link="flange_link"
      xyz_ee="$(arg xyz_ee)"
      rpy_ee="$(arg rpy_ee)"
      tcp_xyz="$(arg tcp_xyz)"
      tcp_rpy="$(arg tcp_rpy)"
      description_pkg="piper_description"/>
  </xacro:if>

  <xacro:if value="$(arg ros2_control)">
    <xacro:piper_arm_ros2_control
      prefix="$(arg prefix)"
      can_interface="$(arg can_interface)"
      init_can="$(arg init_can)"
      use_fake_hardware="$(arg use_fake_hardware)"
      enable_gripper_control="$(arg enable_gripper_control)"/>
  </xacro:if>
</robot>
